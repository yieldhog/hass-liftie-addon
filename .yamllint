---
# Relaxed rules suited to Home Assistant add-on configs.
extends: default

rules:
  document-start: disable
  line-length: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  truthy:
    # Allow GitHub Actions' `on:` key without a truthy warning.
    check-keys: false
    allowed-values: ["true", "false"]

ignore: |
  .git/
